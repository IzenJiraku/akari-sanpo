{
  "manifest_version": 3,
  "name": "Xのかわりに",
  "version": "1.0.0",
  "description": "x.com や twitter.com を開くと、灯の散歩へ移ります。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "to_sanpo",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
